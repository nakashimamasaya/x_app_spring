# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は .gitignore で追跡外。ここには絶対に本物の値を書かないこと。

# --- PostgreSQL ---------------------------------------------------
POSTGRES_DB=xapp
POSTGRES_USER=xapp
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_PORT=5432

# --- Backend ------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
API_PORT=8080

# JWT 署名鍵（HS256）。32 バイト以上のランダム値を使うこと。
# 生成例:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P14D

# CORS 許可オリジン（カンマ区切り）。BFF を挟まないため必須。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend -----------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Local LLM (Ollama) -------------------------------------------
OLLAMA_BASE_URL=http://192.168.11.35:11434
OLLAMA_MODEL=qwen3:14b
